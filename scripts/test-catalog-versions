#!/usr/bin/env bash
set -uo pipefail

# ------------------------------------------------------------------------------
# Unit tests for scripts/catalog-versions.
#
# That script decides what ships in the airgap catalog image, so a bug in it
# silently ships the wrong thing. Plain bash, no test framework to install.
#
#   ./scripts/test-catalog-versions
# ------------------------------------------------------------------------------

SCRIPT_DIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
BASE_DIR="$( cd "${SCRIPT_DIR}" && cd .. && pwd )"
RESOLVE="${SCRIPT_DIR}/catalog-versions"

RED="\033[31m"
GREEN="\033[32m"
BOLD="\033[1m"
RESET="\033[0m"

PASS=0
FAIL=0
TMP=$(mktemp -d)
trap 'rm -rf "${TMP}"' EXIT

# write_manifest <file> <json>
write_manifest() {
  echo "$2" > "${TMP}/$1"
}

# expect <name> <expected> <actual>
expect() {
  local name="$1" expected="$2" actual="$3"
  if [[ "${expected}" == "${actual}" ]]; then
    echo -e "${GREEN} ✔${RESET} ${name}"
    PASS=$((PASS + 1))
  else
    echo -e "${RED} ✘ ${name}${RESET}"
    echo -e "     expected: ${expected}"
    echo -e "     actual:   ${actual}"
    FAIL=$((FAIL + 1))
  fi
}

# expect_fail <name> <command...>  - asserts a non-zero exit
expect_fail() {
  local name="$1"; shift
  if "$@" >/dev/null 2>&1; then
    echo -e "${RED} ✘ ${name}${RESET}  (expected non-zero exit, got 0)"
    FAIL=$((FAIL + 1))
  else
    echo -e "${GREEN} ✔${RESET} ${name}"
    PASS=$((PASS + 1))
  fi
}

# resolve <manifest-file> [extra args...] -> space separated versions for ext "x"
resolve_x() {
  local f="$1"; shift
  "${RESOLVE}" -m "${TMP}/${f}" --ext x "$@" 2>/dev/null | tr '\n' ' ' | sed 's/ $//'
}

echo -e "${BOLD}catalog-versions${RESET}"
echo ""

# --- the rule itself ----------------------------------------------------------

write_manifest single-major.json '{"extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["1.0.0","1.0.1","1.1.0","1.2.0","1.2.5","1.3.0","1.3.1"]}}}'
expect "keeps the last 3 minors of a major, latest patch each" \
  "1.1.0 1.2.5 1.3.1" "$(resolve_x single-major.json)"

write_manifest multi-major.json '{"extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["1.0.0","1.1.0","1.2.0","1.3.0","2.0.0","2.0.1","3.0.0","3.1.0","3.1.4"]}}}'
expect "applies the rule separately to every major" \
  "1.1.0 1.2.0 1.3.0 2.0.1 3.0.0 3.1.4" "$(resolve_x multi-major.json)"

write_manifest few-minors.json '{"extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["2.0.0","2.0.3"]}}}'
expect "keeps everything when a major has fewer than 3 minors" \
  "2.0.3" "$(resolve_x few-minors.json)"

write_manifest one-version.json '{"extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["0.0.1"]}}}'
expect "handles a single-version extension" \
  "0.0.1" "$(resolve_x one-version.json)"

# --- ordering: the bug that byte-wise comparison introduces -------------------

write_manifest double-digit.json '{"extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["1.6.9","1.6.10","1.9.0","1.10.0","1.11.2","1.11.10"]}}}'
expect "orders double-digit minors and patches by version, not lexically" \
  "1.9.0 1.10.0 1.11.10" "$(resolve_x double-digit.json)"

write_manifest patch-order.json '{"extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["2.2.2","2.2.9","2.2.10"]}}}'
expect "picks 2.2.10 over 2.2.9 as the latest patch" \
  "2.2.10" "$(resolve_x patch-order.json)"

# --- exceptions ---------------------------------------------------------------

write_manifest exception.json '{"versionPolicy":{"minorsPerMajor":3,"exceptions":{
  "x":[{"version":"1.0.0","reason":"only build for Rancher 2.10"}]}},
  "extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["1.0.0","1.1.0","1.2.0","1.3.0"]}}}'
expect "an exception adds back a version the rule drops" \
  "1.0.0 1.1.0 1.2.0 1.3.0" "$(resolve_x exception.json)"

write_manifest redundant.json '{"versionPolicy":{"exceptions":{
  "x":[{"version":"1.3.0","reason":"already kept"}]}},
  "extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["1.0.0","1.1.0","1.2.0","1.3.0"]}}}'
expect "a redundant exception does not duplicate the version" \
  "1.1.0 1.2.0 1.3.0" "$(resolve_x redundant.json)"

write_manifest unknown-exception.json '{"versionPolicy":{"exceptions":{
  "x":[{"version":"9.9.9","reason":"does not exist upstream"}]}},
  "extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["1.0.0","1.1.0","1.2.0","1.3.0"]}}}'
expect "an exception for a version not in the manifest cannot invent one" \
  "1.1.0 1.2.0 1.3.0" "$(resolve_x unknown-exception.json)"
expect "that unusable exception is reported with --warn" \
  "1" "$("${RESOLVE}" -m "${TMP}/unknown-exception.json" --ext x --warn 2>&1 >/dev/null | grep -c 'not in the manifest')"

# --- configuration ------------------------------------------------------------

write_manifest minors-1.json '{"versionPolicy":{"minorsPerMajor":1},
  "extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["1.0.0","1.1.0","1.2.0","1.3.0"]}}}'
expect "minorsPerMajor is honoured" \
  "1.3.0" "$(resolve_x minors-1.json)"

write_manifest no-policy.json '{"extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["1.0.0","1.1.0","1.2.0","1.3.0"]}}}'
expect "defaults to 3 minors when versionPolicy is absent" \
  "1.1.0 1.2.0 1.3.0" "$(resolve_x no-policy.json)"

# --- output formats -----------------------------------------------------------

write_manifest two-ext.json '{"extensions":{
  "b-ext":{"repo":"a/b","branch":"gh-pages","versions":["1.0.0","1.1.0"]},
  "a-ext":{"repo":"a/c","branch":"gh-pages","versions":["2.0.0"]}}}'
expect "lines format is '<ext> <version>', extensions alphabetical" \
  "a-ext 2.0.0|b-ext 1.0.0|b-ext 1.1.0" \
  "$("${RESOLVE}" -m "${TMP}/two-ext.json" | tr '\n' '|' | sed 's/|$//')"
expect "json format emits one array per extension" \
  '{"a-ext":["2.0.0"],"b-ext":["1.0.0","1.1.0"]}' \
  "$("${RESOLVE}" -m "${TMP}/two-ext.json" --format json | jq -cS .)"

# --- error handling -----------------------------------------------------------

write_manifest bad.json '{"extensions":{'
expect_fail "rejects invalid JSON" "${RESOLVE}" -m "${TMP}/bad.json"
expect_fail "rejects a missing manifest" "${RESOLVE}" -m "${TMP}/nope.json"
expect_fail "rejects an unknown extension" "${RESOLVE}" -m "${TMP}/two-ext.json" --ext nope
expect_fail "rejects an unknown format" "${RESOLVE}" -m "${TMP}/two-ext.json" --format yaml

write_manifest bad-minors.json '{"versionPolicy":{"minorsPerMajor":0},
  "extensions":{"x":{"repo":"a/b","branch":"gh-pages","versions":["1.0.0"]}}}'
expect_fail "rejects minorsPerMajor of 0" "${RESOLVE}" -m "${TMP}/bad-minors.json"

# --- invariants against the real manifest -------------------------------------
#
# These assert properties, not a snapshot of the resolved list. An earlier
# version hardcoded "kubewarden ... 4.2.3", which broke the moment 4.2.4 was
# published - the resolver was right and the test was stale. Anything asserted
# here has to stay true as extensions publish new versions.
#
# Each invariant is then re-run against a deliberately broken input, so an
# invariant that can no longer detect anything fails loudly instead of passing
# forever on an empty result.

# Shared preamble: for each extension, the published list, the declared
# exceptions, and the versions the rule (rather than an exception) produced.
read -r -d '' PREAMBLE <<'JQ' || true
  def parts: split(".") | map(tonumber);
  ($manifest[0].versionPolicy.minorsPerMajor // 3) as $n
  | $manifest[0].extensions as $exts
  | ($manifest[0].versionPolicy.exceptions // {}) as $exc
  | to_entries[]
  | .key as $ext
  | .value as $resolved
  | ($exts[$ext].versions | map(ltrimstr(" ") | rtrimstr(" "))) as $published
  | (($exc[$ext] // []) | map(.version)) as $exceptions
  | ($resolved | map(select(. as $v | $exceptions | index($v) | not))) as $byRule
JQ

INV_PUBLISHED='$resolved[]
  | select(. as $v | $published | index($v) | not)
  | "\($ext)@\(.) is not published in the manifest"'

INV_MINOR_COUNT='$byRule | map(parts) | group_by(.[0])[]
  | select((map(.[1]) | unique | length) > $n)
  | "\($ext) major \(.[0][0]) keeps \(map(.[1]) | unique | length) minors"'

INV_ONE_PATCH='$byRule | map(parts) | group_by([.[0], .[1]])[]
  | select(length > 1)
  | "\($ext) \(.[0][0]).\(.[0][1]) keeps \(length) patches"'

INV_LATEST_PATCH='($published | map(parts)) as $pp
  | $byRule[] | . as $v | ($v | parts) as $p
  | ($pp | map(select(.[0] == $p[0] and .[1] == $p[1])) | sort | last) as $max
  | select($p != $max)
  | "\($ext)@\($v) is not the latest patch of \($p[0]).\($p[1])"'

INV_EXCEPTIONS_KEPT='$exceptions[]
  | select(. as $v | $published | index($v))
  | select(. as $v | $resolved | index($v) | not)
  | "\($ext)@\(.) is an exception but was not kept"'

# invariant <jq-body> <manifest> <resolved> -> violations, one per line
invariant() {
  jq -r --slurpfile manifest "$2" "${PREAMBLE} | $1" "$3"
}

if [[ -f "${BASE_DIR}/manifest.json" ]]; then
  REAL="${BASE_DIR}/manifest.json"
  "${RESOLVE}" -m "${REAL}" --format json > "${TMP}/resolved.json"

  expect "every resolved version is one the manifest actually publishes" "" \
    "$(invariant "${INV_PUBLISHED}" "${REAL}" "${TMP}/resolved.json")"
  expect "no major keeps more than minorsPerMajor minors by rule" "" \
    "$(invariant "${INV_MINOR_COUNT}" "${REAL}" "${TMP}/resolved.json")"
  expect "the rule keeps at most one patch per minor" "" \
    "$(invariant "${INV_ONE_PATCH}" "${REAL}" "${TMP}/resolved.json")"
  expect "each kept version is the highest published patch of its minor" "" \
    "$(invariant "${INV_LATEST_PATCH}" "${REAL}" "${TMP}/resolved.json")"
  expect "every declared exception that is still published is kept" "" \
    "$(invariant "${INV_EXCEPTIONS_KEPT}" "${REAL}" "${TMP}/resolved.json")"
  expect "the manifest declares exceptions for harvester" "true" \
    "$(jq -r '(.versionPolicy.exceptions.harvester // []) | length > 0' "${REAL}")"
fi

# --- the invariants must be able to fail --------------------------------------

# Needs a 4th non-exception minor, so that a seeded over-wide result is actually
# over-wide once exceptions are filtered out.
write_manifest seed.json '{"versionPolicy":{"minorsPerMajor":3,"exceptions":{
  "x":[{"version":"1.0.0","reason":"pinned"}]}},
  "extensions":{"x":{"repo":"a/b","branch":"gh-pages",
  "versions":["1.0.0","1.1.0","1.2.0","1.3.0","1.3.7","1.4.0"]}}}'

seeded() { echo "$1" > "${TMP}/seeded.json"; invariant "$2" "${TMP}/seed.json" "${TMP}/seeded.json"; }

expect "catches a version that is not published" \
  "x@9.9.9 is not published in the manifest" \
  "$(seeded '{"x":["9.9.9"]}' "${INV_PUBLISHED}")"

expect "catches a major keeping too many minors" \
  "x major 1 keeps 4 minors" \
  "$(seeded '{"x":["1.1.0","1.2.0","1.3.7","1.4.0"]}' "${INV_MINOR_COUNT}")"

expect "catches two patches kept from one minor" \
  "x 1.3 keeps 2 patches" \
  "$(seeded '{"x":["1.3.0","1.3.7"]}' "${INV_ONE_PATCH}")"

expect "catches keeping a stale patch" \
  "x@1.3.0 is not the latest patch of 1.3" \
  "$(seeded '{"x":["1.3.0"]}' "${INV_LATEST_PATCH}")"

expect "catches a published exception being dropped" \
  "x@1.0.0 is an exception but was not kept" \
  "$(seeded '{"x":["1.3.7"]}' "${INV_EXCEPTIONS_KEPT}")"

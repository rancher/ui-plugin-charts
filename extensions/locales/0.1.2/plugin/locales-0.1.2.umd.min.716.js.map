njob":"Los CronJobs crean Jobs, que luego ejecutan Pods, según un programa repetitivo. El programa se expresa en formato Unix cron estándar y usa la zona horaria del plano de control de Kubernetes (generalmente UTC).", "batch.job":"Los Jobs crean uno o más pods para realizar de forma fiable una tarea de una sola vez ejecutando un pod hasta que salga con éxito. Los pods fallidos se reemplazan automáticamente hasta que se alcanza el número especificado de ejecuciones completadas. Los Jobs también pueden ejecutar varios pods en paralelo o funcionar como una cola de trabajo por lotes.", "pod":"Los Pods son las unidades de cómputo implementables más pequeñas que puede crear y administrar en Kubernetes. Un Pod es un grupo de uno o más contenedores, con recursos de almacenamiento y red compartidos, y una especificación de cómo ejecutar los contenedores."}), "upgrading":({"activeDeadlineSeconds":({"label":"Tiempo límite activo del Pod", "tip":"La duración que el pod puede estar activo antes de que el sistema intente marcarlo como fallido y matar los contenedores asociados."}), "concurrencyPolicy":({"label":"Concurrencia", "options":({"allow":"Permitir que los CronJobs se ejecuten concurrentemente", "forbid":"Omitir la siguiente ejecución si la ejecución actual no ha terminado", "replace":"Reemplazar la ejecución si la ejecución actual no ha terminado"})}), "maxSurge":({"label":"Aumento máximo", "tip":"El número máximo de pods permitidos más allá de la escala deseada en cualquier momento."}), "maxUnavailable":({"label":"Máximo no disponible", "tip":"El número máximo de pods que pueden no estar disponibles en cualquier momento."}), "minReadySeconds":({"label":"Mínimo listo", "tip":"La duración mínima que un pod debe estar listo sin que los contenedores fallen para ser considerado disponible."}), "podManagementPolicy":({"label":"Directiva de administración de pods"}), "progressDeadlineSeconds":({"label":"Plazo de progreso", "tip":"La duración mínima de espera para que un despliegue progrese antes de marcarlo como fallido."}), "revisionHistoryLimit":({"label":"Límite de historial de revisiones", "tip":"El número de ReplicaSets antiguos a conservar para revertir."}), "strategies":({"labels":({"delete":"Al eliminar: Los nuevos pods solo se crean cuando los pods antiguos se eliminan manualmente.", "recreate":"Recrear: Matar TODOS los pods, luego iniciar nuevos pods.", "rollingUpdate":"Actualización continua: Crear nuevos pods, hasta que se alcance el aumento máximo, antes de eliminar los pods antiguos. No detener más pods de los no disponibles máximos."})}), "terminationGracePeriodSeconds":({"label":"Período de gracia de terminación", "tip":"La duración que el pod necesita para terminar correctamente."}), "title":"Actualización"}), "tabs":({"labels":({"deployment":"Despliegue", "pod":"Pod", "containers":"Contenedores"})})}), "model":({"account":({"kind":({"admin":"Administrador", "agent":"Agente", "project":"Entorno", "registeredAgent":"Agente registrado", "service":"Servicio", "user":"Usuario"})}), "catalog.cattle.io.app":({"firstDeployed":"Primer despliegue", "lastDeployed":"Último despliegue"}), "authConfig":({"description":({"ldap":"LDAP", "saml":"SAML", "oauth":"OAuth", "oidc":"OIDC", "keycloakoidc":"Keycloak", "genericoidc":"Proveedor OIDC", "cognito":"Amazon Cognito"}), "name":({"azuread":"Microsoft Entra ID", "keycloak":"Keycloak (SAML)", "keycloakoidc":"Keycloak (OIDC)"}), "provider":({"system":"Sistema", "local":"Local", "multiple":"Múltiple", "activedirectory":"ActiveDirectory", "azuread":"Microsoft Entra ID", "github":"GitHub", "githubapp":"GitHub App", "keycloak":"Keycloak", "ldap":"LDAP", "openldap":"OpenLDAP", "shibboleth":"Shibboleth", "ping":"Ping Identity", "adfs":"ADFS", "okta":"Okta", "freeipa":"FreeIPA", "googleoauth":"Google", "genericoidc":"OIDC genérico", "keycloakoidc":"Keycloak", "cognito":"Amazon Cognito"})}), "cluster":({"name":"Nombre del clúster"}), "ingress":({"displayKind":"Ingress L7"}), "machine":({"role":({